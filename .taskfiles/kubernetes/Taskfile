# Taskfile for homelab Kubernetes node management
# Usage from homelab node: go-task -d /path/to/this/dir <task> [args]
# Or copy to homelab node and run: go-task <task> [args]

version: '3'

vars:
  KUBEADM: kubeadm
  KUBECTL: kubectl
  KUBECONFIG: /etc/kubernetes/admin.conf
  NODE_NAME: homelab
  BACKUP_DIR: /root/backups/k8s

# Initialize backup directory
task: init-backups
  cmds:
    - mkdir -p {{.BACKUP_DIR}}
    - echo "Backup directory initialized at {{.BACKUP_DIR}}"

# Backup kubeadm configuration
task: backup-config
  deps: [init-backups]
  cmds:
    - timestamp=$(date +%Y%m%d-%H%M%S)
    - {{.KUBECTL}} --kubeconfig {{.KUBECONFIG}} get cm -n kube-system kubeadm-config -o yaml > {{.BACKUP_DIR}}/kubeadm-config-${timestamp}.yaml
    - echo "kubeadm config backed up to {{.BACKUP_DIR}}/kubeadm-config-${timestamp}.yaml"

# Check current cluster version
task: check-version
  cmds:
    - echo "=== Current Cluster Version ==="
    - {{.KUBECTL}} --kubeconfig {{.KUBECONFIG}} version
    - echo ""
    - echo "=== Node Status ==="
    - {{.KUBECTL}} --kubeconfig {{.KUBECONFIG}} get nodes -o wide

# Check upgrade plan
task: upgrade-plan
  cmds:
    - echo "=== Checking upgrade plan ==="
    - sudo {{.KUBEADM}} upgrade plan

# Upgrade control plane to specific version
task: upgrade-control-plane
  desc: Upgrade control plane to specified version (default: latest stable)
  vars:
    TARGET_VERSION: ""
  cmds:
    - |
      if [ -z "{{.TARGET_VERSION}}" ]; then
        echo "Fetching latest stable version..."
        TARGET_VERSION=$({{.KUBEADM}} version -o short 2>/dev/null | sed 's/v//' || echo "1.37.1")
      fi
      echo "Upgrading control plane to v${TARGET_VERSION}..."
      sudo {{.KUBEADM}} upgrade apply v${TARGET_VERSION} --yes --ignore-preflight-errors=all
  args:
    - name: version
      desc: Target Kubernetes version (e.g., 1.37.1)
      default: ""
      env: TARGET_VERSION

# Upgrade kubelet and kubectl
task: upgrade-node-components
  desc: Upgrade kubelet, kubectl, and kubeadm binaries via pacman
  cmds:
    - echo "Upgrading node components..."
    - sudo pacman -Sy --noconfirm kubernetes-tools
    - sudo systemctl restart kubelet
    - echo "Waiting for kubelet to restart..."
    - sleep 10
    - echo "Node components upgraded"

# Full cluster upgrade workflow
task: upgrade-cluster
  desc: Perform full cluster upgrade to specified version
  deps: [backup-config, upgrade-control-plane, upgrade-node-components]
  vars:
    TARGET_VERSION: ""
  cmds:
    - echo "=== Cluster upgrade to v{{.TARGET_VERSION}} complete ==="
    - echo "Verifying upgrade..."
    - go-task check-version
  args:
    - name: version
      desc: Target Kubernetes version
      default: ""
      env: TARGET_VERSION

# Verify cluster health
task: verify-health
  cmds:
    - echo "=== Verifying Cluster Health ==="
    - {{.KUBECTL}} --kubeconfig {{.KUBECONFIG}} get nodes
    - echo ""
    - echo "=== Control Plane Pods ==="
    - {{.KUBECTL}} --kubeconfig {{.KUBECONFIG}} get pods -n kube-system | grep -E "apiserver|controller|scheduler|etcd|coredns|kube-proxy"
    - echo ""
    - echo "=== Non-Running Pods ==="
    - {{.KUBECTL}} --kubeconfig {{.KUBECONFIG}} get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded

# Clean up old backups (keep last 5)
task: cleanup-backups
  deps: [init-backups]
  cmds:
    - ls -t {{.BACKUP_DIR}}/kubeadm-config-*.yaml 2>/dev/null | tail -n +6 | xargs -I {} rm -f {}
    - echo "Old backups cleaned up (kept last 5)"

# Renew certificates
task: renew-certificates
  desc: Renew all Kubernetes certificates
  cmds:
    - echo "Renewing Kubernetes certificates..."
    - sudo {{.KUBEADM}} certs renew all
    - echo "Restarting control plane pods..."
    - sudo systemctl restart kubelet
    - sleep 15
    - echo "Certificates renewed"

# Default task
default:
  deps: [check-version]
  silent: true
