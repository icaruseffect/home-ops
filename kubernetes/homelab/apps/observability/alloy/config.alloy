logging {
  level  = "info"
  format = "logfmt"
}

// ---------- existing: external syslog listener -> GreptimeDB ----------
loki.source.syslog "syslog_listener" {
  listener {
    address       = "0.0.0.0:30514"
    protocol      = "tcp"
    syslog_format = "rfc5424"
    labels        = { component = "loki.source.syslog", protocol = "tcp", hostname = "__syslog_message_hostname" }
  }
  forward_to = [loki.write.greptime_syslog.receiver]
}

// ---------- new: router (OpenWrt) syslog, fanned out from crowdsec's relay ----------
// crowdsec's syslog-relay sidecar (kubernetes/homelab/apps/crowdsec/helmrelease.yaml)
// normalizes BusyBox's non-standard RFC3164-with-weekday format, then sends
// the same normalized line to both crowdsec's own listener (127.0.0.1:5514)
// and this one, via two independent, non-blocking UDP sendto() calls. An
// Alloy outage or backpressure here can never delay or drop crowdsec's copy —
// see the incident notes above on why crowdsec's detection path shouldn't
// depend on Alloy's health.
loki.source.syslog "router" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { component = "loki.source.syslog.router", source = "router" }
  }
  forward_to = [loki.write.greptime_syslog.receiver]
}

// Loki itself was decommissioned in favor of GreptimeDB (which exposes a
// Loki-compatible push endpoint) - both syslog sources above used to point
// at loki.observability.svc.cluster.local:3100, which no longer exists.
// Kept in its own table (not container_logs) since these aren't k8s pod
// logs.
loki.write "greptime_syslog" {
  endpoint {
    url = "http://greptimedb-standalone.observability.svc.cluster.local:4000/v1/loki/api/v1/push"
    headers = {
      "X-Greptime-DB-Name"        = "public",
      "X-Greptime-Log-Table-Name" = "syslog_logs",
    }
  }
}

// ---------- new: all container logs -> GreptimeDB ----------
discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "container_logs" {
  targets = discovery.kubernetes.pods.targets

  // Cluster-wide log tailing (2026-09-29) overloaded the node's shared disk
  // enough to crash-loop kube-apiserver (see git history / incident notes).
  // Drop infra/system namespaces with high log volume and little search
  // value before loki.source.kubernetes starts a tail for them — cuts both
  // ingestion volume and the per-line CPU cost of loki.process below.
  // "observability" is dropped too, to avoid Alloy/Loki/GreptimeDB
  // ingesting their own logs in a feedback loop. Adjust this list if you
  // want any of these searchable in Greptime.
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "kube-system|kube-node-lease|kube-public|cilium-secrets|flux-system|cert-manager|cnpg-system|k8up-system|kuik|local-path-storage|openebs|system-upgrade|observability"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.container_logs.output
  forward_to = [loki.process.container_logs.receiver]
}

loki.process "container_logs" {
  forward_to = [loki.write.greptime.receiver]

  // zigbee2mqtt logs an MQTT publish line per Zigbee message at info level —
  // extremely high volume. Keep only error-and-above lines for that one
  // container; every other container passes through unfiltered. Lines where
  // the level can't be extracted (e.g. a stack-trace continuation line after
  // an error) are kept rather than dropped.
  stage.match {
    selector = `{container="zigbee2mqtt"}`

    stage.regex {
      expression = `\x1b\[\d+m(?P<level>\w+)\x1b\[39m:`
    }

    stage.drop {
      source     = "level"
      expression = "(?i)^(info|warn|warning|debug)$"
    }
  }
}

loki.write "greptime" {
  endpoint {
    url = "http://greptimedb-standalone.observability.svc.cluster.local:4000/v1/loki/api/v1/push"
    headers = {
      "X-Greptime-DB-Name"        = "public",
      "X-Greptime-Log-Table-Name" = "container_logs",
    }
  }
}
