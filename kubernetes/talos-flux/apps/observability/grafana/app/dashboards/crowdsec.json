      "type": "table",
      "title": "Top blocked IPs",
      "description": "Gateway responses with status 403 and response flag UAEX per source IP, from the Envoy access logs in GreptimeDB (logs.app_logs). Mostly CrowdSec bouncer denials, but Cilium L7 policy denials carry the same flag.",
      "id": 25,
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb"
          },
          "refId": "A",
          "rawSql": "select json_get_string(parse_json(message), 'source_ip') as source_ip, count(*) as blocked, max(greptime_timestamp) as last_seen from logs.app_logs where loki_label_container = 'cilium-envoy' and message like '{%' and message like '%UAEX%' and message like '%\"status\":403%' and $__timeFilter(greptime_timestamp) group by source_ip order by blocked desc limit 25",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
